diff --git a/runner/src/desktop/glsl_shader.c b/runner/src/desktop/glsl_shader.c
index 54f24643..15471c13 100644
--- a/runner/src/desktop/glsl_shader.c
+++ b/runner/src/desktop/glsl_shader.c
@@ -231,10 +231,27 @@ static bool GlslPass_Compile(GlslPass *p, uint type, const uint8 *data, size_t s
   GLint compile_status = 0;
   size_t skip = 0;
 
-  if (size < 8 || memcmp(data, "#version", 8) != 0) {
+  /* GLSL allows comments and blank lines before #version, and many libretro
+   * shaders open with a license comment. Find the directive past those, so
+   * the VERTEX/FRAGMENT defines go after it instead of a second #version. */
+  size_t at = 0;
+  for (;;) {
+    while (at < size && (data[at] == ' ' || data[at] == '\t' || data[at] == '\r' || data[at] == '\n')) at++;
+    if (at + 1 < size && data[at] == '/' && data[at + 1] == '/') {
+      while (at < size && data[at] != '\n') at++;
+    } else if (at + 1 < size && data[at] == '/' && data[at + 1] == '*') {
+      at += 2;
+      while (at + 1 < size && !(data[at] == '*' && data[at + 1] == '/')) at++;
+      at = at + 2 < size ? at + 2 : size;
+    } else {
+      break;
+    }
+  }
+  if (size - at < 8 || memcmp(data + at, "#version", 8) != 0) {
     strings[0] = "#version 330\n";
     lengths[0] = sizeof("#version 330\n") - 1;
   } else {
+    skip = at;
     while (skip < size && data[skip++] != '\n') {}
     strings[0] = (char*)data;
     lengths[0] = (int)skip;
